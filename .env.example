# Copy to .env.local and fill in when you wire app/api/enquiry/route.ts to your
# existing Node/Express + MongoDB Atlas backend.

# Example: URL of your Express endpoint that accepts admission enquiries
# ENQUIRY_API_URL=https://your-express-api.example.com/api/enquiries

# Or, if you connect to MongoDB Atlas directly from the route instead:
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<db>
